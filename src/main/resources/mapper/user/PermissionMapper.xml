<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dboat.user.mapper.PermissionMapper">

    <resultMap id="BaseResultMap" type="com.dboat.user.entity.Permission">
            <id property="permId" column="perm_id" jdbcType="VARCHAR"/>
            <result property="permCode" column="perm_code" jdbcType="VARCHAR"/>
            <result property="permName" column="perm_name" jdbcType="VARCHAR"/>
            <result property="permType" column="perm_type" jdbcType="TINYINT"/>
            <result property="parentPermId" column="parent_perm_id" jdbcType="VARCHAR"/>
            <result property="sortNum" column="sort_num" jdbcType="INTEGER"/>
            <result property="status" column="status" jdbcType="TINYINT"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="deleteTime" column="delete_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        perm_id,perm_code,perm_name,
        perm_type,parent_perm_id,sort_num,
        status,create_time,update_time,
        delete_time
    </sql>

    <!--
        查询用户经 RBAC 授权后拥有的全部启用权限编码
        链路：user_role → role_perm → permission（permission 为全局权限定义表，不带 org_id）
        过滤：各关联表软删除 delete_time IS NULL，且角色/权限均为启用状态
    -->
    <select id="selectPermCodesByUserId" resultType="java.lang.String">
        SELECT DISTINCT p.perm_code
        FROM permission p
        INNER JOIN role_perm rp ON rp.perm_id = p.perm_id
        INNER JOIN user_role ur ON ur.role_id = rp.role_id AND ur.org_id = rp.org_id
        INNER JOIN role r ON r.role_id = ur.role_id AND r.org_id = ur.org_id
        WHERE ur.org_id = #{orgId}
          AND ur.user_id = #{userId}
          AND p.status = 1
          AND r.status = 1
          AND p.delete_time IS NULL
          AND rp.delete_time IS NULL
          AND ur.delete_time IS NULL
          AND r.delete_time IS NULL
        ORDER BY p.perm_code
    </select>
</mapper>
