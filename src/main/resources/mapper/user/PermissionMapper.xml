<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dboat.user.mapper.PermissionMapper">

    <resultMap id="BaseResultMap" type="com.dboat.user.entity.Permission">
            <id property="permId" column="perm_id" jdbcType="VARCHAR"/>
            <result property="permCode" column="perm_code" jdbcType="VARCHAR"/>
            <result property="permName" column="perm_name" jdbcType="VARCHAR"/>
            <result property="permType" column="perm_type" jdbcType="TINYINT"/>
            <result property="parentPermId" column="parent_perm_id" jdbcType="VARCHAR"/>
            <result property="sortNum" column="sort_num" jdbcType="INTEGER"/>
            <result property="status" column="status" jdbcType="TINYINT"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="deleteTime" column="delete_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        perm_id,perm_code,perm_name,
        perm_type,parent_perm_id,sort_num,
        status,create_time,update_time,
        delete_time
    </sql>
</mapper>
